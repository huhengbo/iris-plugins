{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Iris plugin repository index (schema 1)",
  "description": "Iris 插件仓库 index.json 的 schema 1。宿主忽略未知字段；条目按 §4.1 的规则逐条校验。",
  "type": "object",
  "required": ["schema", "name", "generated_at", "plugins"],
  "properties": {
    "schema": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "plugins": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/plugin"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "plugin": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "version",
        "sdk",
        "provides",
        "capabilities",
        "url",
        "sha256",
        "size"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?!builtin\\.)[a-z0-9][a-z0-9._-]{0,63}$",
          "description": "与宿主备份的 _PLUGIN_ID 一致；builtin. 前缀保留给系统插件。"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){0,3}$"
        },
        "sdk": {
          "type": "string",
          "pattern": "^(>=|<=|==|>|<)\\s*[0-9]+(\\.[0-9]+)*(\\s*,\\s*(>=|<=|==|>|<)\\s*[0-9]+(\\.[0-9]+)*)*$"
        },
        "provides": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "format": "uri-reference",
          "description": "绝对地址，或相对 index.json 的地址。"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        },
        "homepage": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "signature": {
          "type": ["string", "null"],
          "description": "预留字段；本次只透传，不校验。"
        }
      },
      "additionalProperties": true
    }
  }
}
